{
    "name": "mdo",
    "version": "2.1.0",
    "scripts": {
        "ng": "ng",
        "start": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy/localhost.proxy.json -o",
        "dev": "npm run start:mdo-dev",
        "build-dev": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=dev --base-href=/",
        "build-benchmark": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=benchmark --base-href=/",
        "build-preprod": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=preprod --base-href=/",
        "build-np": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=np --base-href=/",
        "build": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=production --base-href=/",
        "build:local": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=dev",
        "postbuild": "npm run compress:gzip && npm run compress:brotli",
        "compress:brotli": "gzipper --brotli --gzip-level=9 --verbose ./dist/www",
        "compress:gzip": "gzipper --verbose --gzip-level=9 ./dist/www",
        "build:stats": "ng build --stats-json",
        "start:mdo-dev": "node --max_old_space_size=12288 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy/mdo-dev-ip.proxy.json -o",
        "test": "jest",
        "test-watch": "jest --watch",
        "test-coverage": "jest --coverage",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix",
        "i18n": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng extract-i18n --output-path locale",
        "tailwind": "npx tailwindcss -i ./src/tailwind-build.scss -o ./src/styles.scss",
        "prestart": "npm run tailwind",
        "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\""
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "20.3.25",
        "@angular/cdk": "20.2.14",
        "@angular/common": "20.3.25",

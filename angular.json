{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "project",
  "projects": {
    "mdo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ws",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/www/en",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init",
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "preserveSymlinks": true,
            "assets": [
              "src/favicon.ico",
              "src/favicon.png",
              "src/assets",
              "src/mdo-assets"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "styles": [
              {
                "input": "src/styles/libraries.scss",
                "bundleName": "libraries",
                "inject": true
              },
              "node_modules/material-icons/iconfont/material-icons.scss",
              "src/styles/mat-typography.scss",
              "src/styles/styles.scss",
              "node_modules/shepherd.js/dist/css/shepherd.css",
              "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              {
                "inject": false,
                "input": "src/themes/theme-deep-purple.scss",
                "bundleName": "theme-deep-purple"
              },
              {
                "inject": false,
                "input": "src/themes/theme-grey.scss",
                "bundleName": "theme-grey"
              },
              {
                "inject": false,
                "input": "src/themes/theme-indigo.scss",
                "bundleName": "theme-indigo"
              },
              {
                "inject": false,
                "input": "src/themes/theme-lite-blue.scss",
                "bundleName": "theme-lite-blue"
              },
              {
                "inject": false,
                "input": "src/themes/theme-orange.scss",
                "bundleName": "theme-orange"
              },
              {
                "inject": false,
                "input": "src/themes/theme-teal.scss",
                "bundleName": "theme-teal"
              },
              {
                "inject": false,
                "input": "src/themes/theme-blue.scss",
                "bundleName": "theme-blue"
              },
              {
                "inject": false,
                "input": "src/themes/theme-deep-blue.scss",
                "bundleName": "theme-deep-blue"
              },
              {
                "inject": true,
                "input": "src/themes/theme-igot.scss",
                "bundleName": "theme-igot"
              },
              "node_modules/pdfjs-dist/web/pdf_viewer.css",
              "src/mdo-assets/fonts/lato/stylesheet.css",
              "src/mdo-assets/fonts/montserrat/stylesheet.css",
              "node_modules/typeface-roboto/index.css",
              "src/styles.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/@project-sunbird/telemetry-sdk/index.js",
              "node_modules/shepherd.js/dist/js/shepherd.min.js",
              "node_modules/hammerjs/hammer.min.js"
            ],
            "sourceMap": true,
            "optimization": false
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            },
            "np": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.np.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            },
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            },
            "preprod": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.preprod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                }
              ]
            },
            "benchmark": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.bm.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "20mb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "buildTarget": "mdo:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "mdo:build:production"
            },
            "dev": {
              "buildTarget": "mdo:build:dev"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "mdo:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "@ws/app": {
      "projectType": "library",
      "root": "project/ws/app",
      "sourceRoot": "project/ws/app/src",
      "prefix": "ws-app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "project/ws/app/tsconfig.lib.json",
            "project": "project/ws/app/ng-package.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "project/ws/app/src/**/*.ts",
              "project/ws/app/src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}